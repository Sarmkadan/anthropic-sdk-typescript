{
  "$schema": "https://raw.githubusercontent.com/sarmkadan/anthropic-sdk-typescript/main/appsettings.example.json",
  "anthropic": {
    "apiKey": "your-api-key-here",
    "baseUrl": "https://api.anthropic.com",
    "timeout": 600000,
    "maxRetries": 2,
    "logLevel": "warn",
    "dangerouslyAllowBrowser": false,
    "webhookKey": "your-webhook-signing-key-here",
    "defaultHeaders": {
      "X-Custom-Header": "value"
    },
    "defaultQuery": {
      "custom_param": "value"
    }
  }
}
